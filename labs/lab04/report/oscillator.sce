// Очистить все графические окна (универсально)
try
    xdel(winsid());
catch
    // Если не работает - игнорируем
end

clc; clear; 

// ========== ПАРАМЕТРЫ ==========
t0 = 0;              // начальное время
t = 0:0.05:50;       // временной интервал
x0 = [-1; 1];        // начальные условия [x(0); x'(0)]

// ========================================
// СЛУЧАЙ 1: Без затухания (γ=0, ω=1)
// Уравнение: x'' + x = 0
// ========================================

w1 = 1.0;    // частота
g1 = 0.0;    // затухание

function f=f1(t)
    f = 0;   // внешняя сила отсутствует
endfunction

function dx=sys1(t, x)
    dx(1) = x(2);
    dx(2) = -w1^2*x(1) - g1*x(2) + f1(t);
endfunction

X1 = ode(x0, t0, t, sys1);
x1 = X1(1,:);   // координата
y1 = X1(2,:);   // скорость

// ========================================
// СЛУЧАЙ 2: С затуханием (γ=0.5, ω=1)
// Уравнение: x'' + 0.5x' + x = 0
// ========================================

w2 = 1.0;
g2 = 0.5;

function f=f2(t)
    f = 0;
endfunction

function dx=sys2(t, x)
    dx(1) = x(2);
    dx(2) = -w2^2*x(1) - g2*x(2) + f2(t);
endfunction

X2 = ode(x0, t0, t, sys2);
x2 = X2(1,:);
y2 = X2(2,:);

// ========================================
// СЛУЧАЙ 3: С внешней силой (γ=0.3, ω=1)
// Уравнение: x'' + 0.3x' + x = 0.5*sin(t)
// ========================================

w3 = 1.0;
g3 = 0.3;

function f=f3(t)
    f = 0.5*sin(t);  // внешняя сила
endfunction

function dx=sys3(t, x)
    dx(1) = x(2);
    dx(2) = -w3^2*x(1) - g3*x(2) + f3(t);
endfunction

X3 = ode(x0, t0, t, sys3);
x3 = X3(1,:);
y3 = X3(2,:);

// ========================================
// ПОСТРОЕНИЕ ГРАФИКОВ
// ========================================

// --- Случай 1: Решение ---
scf(1); clf();
plot(t, x1, 'b-', 'LineWidth', 2);
xlabel('Время t', 'FontSize', 3);
ylabel('x(t)', 'FontSize', 3);
title('БЕЗ ЗАТУХАНИЯ: x'''' + x = 0', 'FontSize', 4);
xgrid();

// --- Случай 1: Фазовый портрет ---
scf(2); clf();
plot(x1, y1, 'r-', 'LineWidth', 2);
xlabel('x (координата)', 'FontSize', 3);
ylabel('y = x'' (скорость)', 'FontSize', 3);
title('ФАЗОВЫЙ ПОРТРЕТ 1 (без затухания)', 'FontSize', 4);
xgrid();

// --- Случай 2: Решение ---
scf(3); clf();
plot(t, x2, 'b-', 'LineWidth', 2);
xlabel('Время t', 'FontSize', 3);
ylabel('x(t)', 'FontSize', 3);
title('С ЗАТУХАНИЕМ: x'''' + 0.5x'' + x = 0', 'FontSize', 4);
xgrid();

// --- Случай 2: Фазовый портрет ---
scf(4); clf();
plot(x2, y2, 'r-', 'LineWidth', 2);
xlabel('x (координата)', 'FontSize', 3);
ylabel('y = x'' (скорость)', 'FontSize', 3);
title('ФАЗОВЫЙ ПОРТРЕТ 2 (с затуханием)', 'FontSize', 4);
xgrid();

// --- Случай 3: Решение ---
scf(5); clf();
plot(t, x3, 'b-', 'LineWidth', 2);
xlabel('Время t', 'FontSize', 3);
ylabel('x(t)', 'FontSize', 3);
title('С ВНЕШНЕЙ СИЛОЙ: x'''' + 0.3x'' + x = 0.5sin(t)', 'FontSize', 4);
xgrid();

// --- Случай 3: Фазовый портрет ---
scf(6); clf();
plot(x3, y3, 'r-', 'LineWidth', 2);
xlabel('x (координата)', 'FontSize', 3);
ylabel('y = x'' (скорость)', 'FontSize', 3);
title('ФАЗОВЫЙ ПОРТРЕТ 3 (с внешней силой)', 'FontSize', 4);
xgrid();

disp("=================================");
disp("ЛАБОРАТОРНАЯ ВЫПОЛНЕНА!");
disp("Открыто 6 окон с графиками");
disp("=================================");
